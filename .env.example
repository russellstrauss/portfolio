# Build-time env for the Metaprompt Studio app (see public/apps/metaprompt-studio).
# Production (Cloudflare Pages): add a secret named exactly VITE_GEMINI_API_KEY in
# Settings → Environment variables (Production). It is injected at build time.
VITE_GEMINI_API_KEY=

# Optional: base URL for the portfolio app (e.g. when deployed to a subpath)
# VITE_BASE_URL=/
